# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║              Enterprise RAG OS — Development Dockerfile                      ║
# ║                                                                              ║
# ║  Includes dev dependencies, hot-reload, and debug tools.                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

FROM python:3.12-slim

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install dependencies (cached layer)
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"

# Copy application code (changes frequently — last layer)
COPY . .

# Create runtime directories
RUN mkdir -p data vector_store cache logs

EXPOSE 8000

# Development server with hot-reload
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
