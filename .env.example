# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                        Enterprise RAG OS — Environment                       ║
# ║                                                                              ║
# ║  Copy this file to .env and fill in the values.                              ║
# ║  Never commit .env to version control.                                       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Enterprise RAG OS"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
LOG_LEVEL="DEBUG"                  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Server ────────────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000
WORKERS=1                          # Uvicorn workers (set >1 for production)
RELOAD=true                        # Auto-reload on code changes (dev only)

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'
CORS_ALLOW_CREDENTIALS=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FORMAT="json"                  # json | text
LOG_FILE="logs/enterprise_rag.log"
LOG_ROTATION="10 MB"
LOG_RETENTION="30 days"

# ── LLM Providers (Phase 4) ──────────────────────────────────────────────────
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
# COHERE_API_KEY=""
# OPENROUTER_API_KEY=""
# OLLAMA_BASE_URL="http://localhost:11434"

# ── Embedding Models (Phase 2) ───────────────────────────────────────────────
# EMBEDDING_PROVIDER="sentence-transformers"    # sentence-transformers | openai | instructor | bge | e5
# EMBEDDING_MODEL="all-MiniLM-L6-v2"
# EMBEDDING_DIMENSION=384
# EMBEDDING_BATCH_SIZE=32

# ── Vector Store (Phase 2) ───────────────────────────────────────────────────
# VECTORSTORE_PROVIDER="chromadb"    # chromadb | qdrant | faiss
# CHROMADB_PERSIST_DIR="./vector_store/chromadb"
# QDRANT_HOST="localhost"
# QDRANT_PORT=6333
# QDRANT_COLLECTION="enterprise_rag"

# ── Chunking (Phase 2) ───────────────────────────────────────────────────────
# CHUNKING_STRATEGY="recursive"     # recursive | semantic | markdown | token | sliding_window | parent_child
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50

# ── Retrieval (Phase 3) ──────────────────────────────────────────────────────
# RETRIEVAL_TOP_K=20
# RERANK_TOP_K=5
# RETRIEVAL_STRATEGY="hybrid"       # dense | bm25 | hybrid

# ── Security (Phase 6) ───────────────────────────────────────────────────────
# JWT_SECRET_KEY=""                  # Generate with: openssl rand -hex 32
# JWT_ALGORITHM="HS256"
# JWT_EXPIRATION_MINUTES=30
# API_KEY_HEADER="X-API-Key"
# RATE_LIMIT_PER_MINUTE=60

# ── Cache ─────────────────────────────────────────────────────────────────────
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=3600
# REDIS_URL="redis://localhost:6379/0"

# ── Observability (Phase 5) ──────────────────────────────────────────────────
# LANGSMITH_API_KEY=""
# LANGSMITH_PROJECT="enterprise-rag"
# MLFLOW_TRACKING_URI="http://localhost:5000"
